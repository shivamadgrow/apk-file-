# Copy this file to "keystore.properties" (same directory) and fill in real values.
# "keystore.properties" itself is gitignored — never commit it or the .jks file.
#
# storeFile should be an ABSOLUTE path to a keystore kept OUTSIDE this repository
# (e.g. in a password manager's secure file storage, or an encrypted backup drive),
# never inside android/ or anywhere under version control.
#
# See RELEASE_SIGNING.md in this directory for how to generate the keystore and the
# full first-release procedure.

storeFile=/absolute/path/to/your/upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=paisainminutes-upload
keyPassword=CHANGE_ME
